# ==========================================================
# CONTOH environment variables backend.
# Copy jadi `.env` terus isi nilainya. JANGAN commit `.env`.
# ==========================================================

# === Server ===
PORT=5000
NODE_ENV=development

# Origin frontend yang diizinkan CORS. Boleh lebih dari satu, pisah pakai koma.
# Production (Render): isi URL Vercel, contoh https://nama-app.vercel.app
FRONTEND_URL=http://localhost:5173
# Nama lama, masih didukung sebagai fallback kalau FRONTEND_URL kosong.
CLIENT_ORIGIN=http://localhost:5173

# === Database (PostgreSQL — Neon) ===
# Ambil dari Neon Console > Project > Connect. Pakai connection string yang
# POOLED (host-nya ada '-pooler') dan wajib pakai ?sslmode=require.
# Karakter spesial di password harus URL-encoded: ! -> %21, @ -> %40, # -> %23
DATABASE_URL=
# Opsional: connection string DIRECT (tanpa '-pooler') buat `prisma migrate`.
# Kalau dikosongin, migrasi pakai DATABASE_URL.
DIRECT_URL=

# Tuning pool koneksi (opsional, ada default di src/config/env.js)
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECT_TIMEOUT_MS=10000

# === API Keys (isi punya sendiri, JANGAN commit nilainya) ===
# CoinGecko demo key: coingecko.com > Developer Dashboard
COINGECKO_API_KEY=
# Helius (RPC Solana + token balances): dashboard.helius.dev
HELIUS_API_KEY=
# Alchemy (holdings ERC-20 Ethereum via alchemy_getTokenBalances): alchemy.com
ALCHEMY_API_KEY=
# Infura: TIDAK dipakai service manapun saat ini, disimpan buat cadangan.
INFURA_PROJECT_ID=

# === JWT ===
# Generate 64-byte hex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# === Cache TTL (detik) ===
CACHE_TTL_MARKET=60
CACHE_TTL_HISTORY=300
CACHE_TTL_COIN_LIST=86400
CACHE_TTL_NONCE=300
CACHE_TTL_HOLDINGS=60

# === Rate limiter incoming (per IP) ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# === Throttle enrich CoinGecko saat scan ===
# Makin kecil = makin aman dari rate limit, tapi scan makin lama.
SCAN_CONCURRENCY=3
