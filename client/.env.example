# ==========================================================
# CONTOH environment variables frontend.
# Copy jadi `.env` terus isi nilainya. JANGAN commit `.env`.
# Semua var HARUS diawali VITE_ biar kebaca Vite.
# ==========================================================

# URL backend API, TANPA trailing slash.
# Development : http://localhost:5000/api
# Production  : https://<nama-service>.onrender.com/api
VITE_API_URL=

# Jaringan Solana: mainnet-beta | devnet | testnet
VITE_SOLANA_NETWORK=mainnet-beta
